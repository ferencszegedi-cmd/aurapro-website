---
import PageLayout from '../layouts/PageLayout.astro';

const H2 = 'font-heading font-bold text-2xl text-heading mt-10';
const H3 = 'font-heading font-semibold text-xl text-heading mt-6';
const TD = 'align-top px-3 py-2 border-b border-border';
const TH = 'text-left px-3 py-2 border-b-2 border-border font-heading font-semibold text-heading';
---

<PageLayout
  title="Adatkezelési tájékoztató – Aurapro Kft."
  description="Az Aurapro Kft. adatkezelési tájékoztatója: milyen személyes adatokat kezelünk a weboldalon, milyen célból és jogalapon, kik az adatfeldolgozók, és milyen jogok illetik meg Önt."
  canonical="/adatvedelem/"
>
  <section class="py-16 lg:py-24 bg-gradient-to-br from-teal-light to-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="font-heading font-bold text-4xl lg:text-5xl text-heading">Adatkezelési tájékoztató</h1>
      <p class="mt-4 text-muted">Hatályos: 2026. augusztus 25-től. Korábbi változat: 2026. május 16.</p>
    </div>
  </section>

  <section class="py-16 lg:py-20 bg-white">
